root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 100
ij_kotlin_allow_trailing_comma = false

[*.{xml,yml,yaml,json,toml}]
indent_size = 4

[*.{md}]
trim_trailing_whitespace = false
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[*.{gradle,properties}]
indent_size = 4

[*.png]
insert_final_newline = false
